Bootstrap: docker
From: rockylinux/rockylinux:8

%files
    /sw/viz/jupyterhub-nhr/jupyter-containers/data/gwdg.repo /etc/yum.repos.d/gwdg.repo
    /sw/viz/jupyterhub-nhr/jupyter-containers/data/Xorg.0.log /var/log/Xorg.0.log
    /sw/viz/jupyterhub-nhr/jupyter-containers/data/update-desktop-files.sh /usr/local/share/update-desktop-files.sh
    /sw/viz/jupyterhub-nhr/jupyter-containers/data/setup_audio_server.py /usr/local/share/setup_audio_server.py
    /sw/viz/jupyterhub-nhr/jupyter-containers/data/audio-proxy.sh /usr/local/bin/audio-proxy.sh
    /sw/viz/jupyterhub-nhr/jupyter-containers/data/audio-plugin.js /usr/local/share/audio-plugin.js

%post

    # /tmp inside the container is a small fixed-size tmpfs (4GiB, already
    # ~40% used before any package is installed) - this is set up by
    # apptainer independently of any host-side TMPDIR/APPTAINER_TMPDIR.
    # pip/tempfile default to /tmp unless TMPDIR is set, so redirect it
    # to the container's real (Lustre backed, spacious) rootfs instead.

    mkdir -p /root/tmp
    export TMPDIR=/root/tmp

    curl -o /etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-8 https://ftp.gwdg.de/pub/linux/fedora/epel/RPM-GPG-KEY-EPEL-8

    # Configure repositories
    rm -f /etc/yum.repos.d/[^g]*

    echo "max_parallel_downloads=15" >> /etc/dnf/dnf.conf
    echo "exclude=rocky-repos rocky-release" >> /etc/dnf/dnf.conf
    echo "8.10" > /etc/dnf/vars/releasever
    echo "8" > /etc/dnf/vars/majorver
    echo "pub/linux/rocky" > /etc/dnf/vars/contentdir

    dnf update -y

    # Create slurmuser
    groupadd -g 450 slurm
    useradd -m -c "SLURM workload manager" -d /var/lib/slurm -u 450 -g slurm -s /bin/bash slurm

    # Install basic system tools
    dnf install -y make gcc wget curl file perl tcl tcsh openssh htop Lmod git tmux zsh \
        openssl ca-certificates python3.11-pip python3.11-setuptools-rust man-pages man-db man

    # Put all jupyter dependencies into their own venv
    python3.11 -m venv /opt/jupyter
    export PATH=/opt/jupyter/bin:$PATH

    # Install jupyter dependencies (jupyterhub, jupyter-remote-desktop-proxy)
    pip install --no-cache-dir 'jupyter-remote-desktop-proxy>=3.0.1' jupyterhub
    install_dir=$(pip show jupyter-remote-desktop-proxy | awk '/^Location:/ { print $2 }')
    ln -s /opt/jupyter/bin/jupyterhub-singleuser /usr/local/bin

    # Link xstartup file
    ln -s /sw/scc-sw /opt/sw
    ln -sf /sw/viz/jupyterhub-nhr/jupyter-containers/desktop.xstartup ${install_dir}/jupyter_remote_desktop_proxy/share/xstartup


    # Installing the nvidia drivers and libraries
    NVIDIA_VER="570.195.03-1.el8"

    mkdir /root/nvidia-rpms
    pushd /root/nvidia-rpms
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/libnvidia-cfg-${NVIDIA_VER}.x86_64.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/libnvidia-ml-${NVIDIA_VER}.x86_64.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/nvidia-driver-${NVIDIA_VER}.x86_64.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/nvidia-driver-libs-${NVIDIA_VER}.x86_64.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/nvidia-driver-cuda-${NVIDIA_VER}.x86_64.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/nvidia-driver-cuda-libs-${NVIDIA_VER}.x86_64.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/nvidia-kmod-common-${NVIDIA_VER}.noarch.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/nvidia-modprobe-${NVIDIA_VER}.x86_64.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/kmod-nvidia-open-dkms-${NVIDIA_VER}.noarch.rpm
    curl -O https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/nvidia-persistenced-${NVIDIA_VER}.x86_64.rpm

    dnf install -y *.rpm
    popd
    rm -rf /root/nvidia-rpms

    # Install VNC requirements (turbovnc, dbus, virtualgl, mesa, etc)
    dnf install -y tigervnc-server tigervnc-server-module dbus-x11 VirtualGL \
        libevent libXrender libxcrypt glx-utils mesa-dri-drivers mesa-libGLU libglvnd-opengl libglvnd-egl

    # Install GNOME desktop environment (and GUI programs)
    dnf group list
    dnf group list --hidden
    dnf groupinstall -y "base-x" "GNOME Desktop Environment" "GNOME Applications"

    dnf install -y qt5-qtbase-gui icu libicu50 emacs vim-enhanced nano nedit neovim geany gedit firefox fakeroot bash-completion bind-utils telnet vlc
    dnf install -y atk fftw-libs libatomic libgfortran libnsl libXScrnSaver mesa-libOSMesa sqlite strace xcb-util-cursor xdg-utils PackageKit
    dnf install -y vlc vlc-extras qt5-qtsvg

    # VDPAU drivers (used for encoding videos, not actually needed for the VirtualGL image pipeline)
    dnf install -y libvdpau mesa-vdpau-drivers libva-vdpau-driver libva-utils vdpauinfo

    rm -f /etc/profile.d/PackageKit.sh

    # Fonts
    dnf install -y dejavu-sans-fonts liberation-fonts mathjax-ams-fonts redhat-display-fonts google-roboto-fonts

    # Fix xkb-lib
    rm -rf /var/lib/xkb
    ln -s /tmp/xkb /var/lib/xkb

    dnf install -y cudnn
    dnf install -y git

    # Append commands for conda environment and jupyter notebooks
    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba
    export MAMBA_ROOT_PREFIX=$HOME/micromamba
    eval "$(./bin/micromamba shell hook -s posix)"
    # Linux/bash:
    ./bin/micromamba shell init -s bash -r ~/micromamba  # this writes to your .bashrc file
    # sourcing the bashrc file incorporates the changes into the running session.
    source ~/.bashrc
    # root's default .bashrc on Rocky commonly aliases mv/rm/cp to their -i
    # variants; since this build runs in an interactive srun session (a real
    # TTY), an -i prompt on a later `mv` would hang waiting for input instead
    # of failing loudly. Clear all inherited aliases to avoid that.
    unalias -a 2>/dev/null || true

    micromamba activate
    # exclusive conda-forge setup
    micromamba config append channels conda-forge
    micromamba config set channel_priority strict

    # The build host has no GPU, so micromamba's solver can't auto-detect the
    # __cuda virtual package and rejects every pytorch-gpu build that requires
    # a cuda* variant ("... which is missing on the system"). Override it to
    # match the driver branch installed above (570.x ships with CUDA 12.8) so
    # the solver picks a compatible pytorch-gpu build instead of failing.
    export CONDA_OVERRIDE_CUDA="12.8"

    # environment for micro-sam, sarcasm, trackastra
    micromamba create -n hsc_course python=3.11 -y
    micromamba activate hsc_course

    # Install jupyter notebook packages and CUDA
    micromamba install --quiet --yes \
        notebook \
        jupyterhub \
        jupyterlab

    micromamba install --quiet --yes \
        jupyter \
        napari \
        pyqt \
        pycocotools \
        python-elf \
        tensorboard \
        tifffile \
        tqdm \
        torch_em \
        micro_sam \
        torchvision \
        torchaudio \
        pytorch-gpu

    export MAMBA_PREFIX=$HOME/micromamba/envs/hsc_course
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$MAMBA_PREFIX/lib/

    # install other repositories
    python3.11 -m pip install --no-cache-dir git+https://github.com/computational-cell-analytics/synapse-net
    git clone https://github.com/computational-cell-analytics/synapse-net
    cd synapse-net
    python3.11 -m pip install --no-cache-dir -e .
    cd ..
    python3.11 -m pip install --no-cache-dir trackastra
    # removed because of missing module
    # python3.11 -m pip install --no-cache-dir sarc-asm
    du -sh "$MAMBA_ROOT_PREFIX"/envs/* "$MAMBA_ROOT_PREFIX"/pkgs 2>/dev/null || true

    # environment for Cellpose
    micromamba deactivate
    micromamba create -n cellpose python=3.11 -y
    micromamba activate cellpose

    # Install jupyter notebook packages and CUDA
    micromamba install --quiet --yes \
        notebook \
        jupyterhub \
        jupyterlab \
        matplotlib \
        torchvision \
        torchaudio \
        pytorch-gpu

    # Cellpose packages
    python3.11 -m pip install --no-cache-dir "cellpose[gui]<4" "pyqt6<6.10"

    # environment for stardist
    micromamba deactivate
    micromamba create -n stardist python=3.11 napari pyqt stardist-napari -y
    micromamba activate stardist

    # Install jupyter notebook packages
    micromamba install --quiet --yes \
        notebook \
        jupyterhub \
        jupyterlab

    # Install tensorflow
    python3.11 -m pip install --no-cache-dir 'tensorflow[and-cuda]'
    python3.11 -m pip install --no-cache-dir stardist
    python3.11 -m pip install --no-cache-dir 'numpy<2'

    # Override gnome-session-quit to kill the container and end the job
    # (Unfortunately also removes the countdown.)
    echo -e '#!/bin/bash\n\nkill $(pgrep -u $(id -u) gnome-session)' > /usr/bin/gnome-session-quit

    # Provide helper to clean envvars in order to e.g. allow starting new jobs via srun
    echo -e '#!/bin/bash\n\nfor var in $(env | egrep -o "^SLURM_[^=]+") LD_PRELOAD\ndo\n    eval unset $var\ndone' > /usr/local/bin/clean_slurm_env
    chmod 755 /usr/local/bin/clean_slurm_env

    # Fix the client_cert issue with jupyterhub_singleuser (without client cert should return None, not '')
    sed -i 's/if self.request.client_cert is not None/if self.request.client_cert is not None and self.request.client_cert != ""/g' /opt/jupyter/lib64/python3.11/site-packages/tornado/simple_httpclient.py

    # Setup audio passthrough
    dnf install -y socat gstreamer1 gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free pulseaudio pulseaudio-utils
    mv /usr/local/share/setup_audio_server.py ${install_dir}/jupyter_remote_desktop_proxy/setup_audio_server.py
    # Use the jupyter venv's own pip explicitly - by this point in the script
    # several `micromamba activate` calls have prepended their env's bin/ onto
    # PATH, so a bare `pip` no longer resolves to /opt/jupyter/bin/pip where
    # jupyter-remote-desktop-proxy is actually installed.
    entry_points="${install_dir}/$(/opt/jupyter/bin/pip show -f jupyter-remote-desktop-proxy | grep "entry_points.txt" | xargs)"
    echo 'desktop-audio = jupyter_remote_desktop_proxy.setup_audio_server:setup_audio_server' >> ${entry_points}
    mv /usr/local/share/audio-plugin.js ${install_dir}/jupyter_remote_desktop_proxy/static/dist/audio-plugin.js
    chmod 664 ${install_dir}/jupyter_remote_desktop_proxy/static/dist/audio-plugin.js
    sed -i '/<\/script>/a     <script src="\{\{base_url\}\}desktop/static/dist/audio-plugin.js"><\/script>' ${install_dir}/jupyter_remote_desktop_proxy/templates/index.html

    echo "micromamba shell init --shell bash --root-prefix=/root/micromamba"  > $HOME/activate_micromamba.sh
    echo "source ~/.bashrc" >> $HOME/activate_micromamba.sh

    # test micro-sam
    cmd_array=(	'"import micro_sam.util as util;'
	'import numpy as np;'
	"x=(np.random.rand(256,256)*255).astype('uint8');"
	'model=util.get_sam_model();'
	'util.precompute_image_embeddings(model,x)"')
    cmd="${cmd_array[*]}"
    echo python3.11 -c "$cmd" > $HOME/test_micro-sam.sh

    # test CUDA availability
    cmd_array=( '"import torch;'
        'torch.cuda.is_available()"')
    cmd="${cmd_array[*]}"
    echo python3.11 -c "$cmd" > $HOME/test_cuda.sh

    chmod u+x $HOME/activate_micromamba.sh
    chmod u+x $HOME/test_micro-sam.sh
    chmod u+x $HOME/test_cuda.sh

%environment
    # firefox does not work with user.max_net_namespaces=0
    export MOZ_ASSUME_USER_NS=0
    export JUPYTERHUB_DEFAULT_URL="/desktop"
    export PATH="${PATH}:/usr/local/slurm/current/install/bin"
    export XDG_DATA_DIRS="/usr/local/share:/usr/share:/var/lib/flatpak/exports/share"
    export PS1="\u@\h \W \$ "
